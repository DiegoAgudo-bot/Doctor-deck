# Copia este fichero a .env y ajusta los valores. .env nunca se sube al repo.

# SQLite local (ruta relativa a la raíz del proyecto)
DATABASE_URL="file:./data/deck-doctor.db"

# Carpeta donde se descargan los bulk data de Scryfall
SCRYFALL_DATA_DIR="./data/scryfall"
# Caché de imágenes de cartas (se sirven desde /img/…; así no dependen de Scryfall/Cloudflare)
IMAGE_CACHE_DIR="./data/images"
IMAGE_CACHE_MAX_MB=2000

# User-Agent identificable para Scryfall y EDHREC, p. ej. "DeckDoctor/0.1 (tu-email-o-url)"
HTTP_USER_AGENT="DeckDoctor/0.1"

# Milisegundos mínimos entre peticiones
SCRYFALL_MIN_INTERVAL_MS=100
EDHREC_MIN_INTERVAL_MS=1000

# Intervalo mínimo entre peticiones a Archidekt / Moxfield (ms)
DECK_SOURCES_MIN_INTERVAL_MS=1000

# TTL de la caché de EDHREC en horas
EDHREC_CACHE_TTL_HOURS=24

# --- Usuarios ---
# Secreto para firmar las sesiones (obligatorio en producción). Genera uno con:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública de la app (la misma que ves en el navegador, sin barra final). En Docker la pone
# docker-compose.yml a partir de DECK_DOCTOR_HOST.
BETTER_AUTH_URL="http://localhost:3000"

# Login con Google (opcional). Credenciales OAuth de Google Cloud Console con la URI de redirección
#   <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email para "olvidé mi contraseña" (opcional). Si falta, la opción no aparece.
#   SMTP_URL="smtps://usuario:clave@smtp.ejemplo.com:465"
SMTP_URL=
MAIL_FROM="Deck Doctor <no-reply@ejemplo.com>"
