# Copia este fichero a .env y ajusta los valores. .env nunca se sube al repo.

# SQLite local (ruta relativa a la raíz del proyecto)
DATABASE_URL="file:./data/deck-doctor.db"

# Carpeta donde se descargan los bulk data de Scryfall
SCRYFALL_DATA_DIR="./data/scryfall"
# Caché de imágenes de cartas (se sirven desde /img/…; así no dependen de Scryfall/Cloudflare)
IMAGE_CACHE_DIR="./data/images"
IMAGE_CACHE_MAX_MB=2000

# User-Agent identificable para Scryfall y EDHREC, p. ej. "DoctorDeck/0.1 (tu-email-o-url)"
HTTP_USER_AGENT="DoctorDeck/0.1"

# Milisegundos mínimos entre peticiones
SCRYFALL_MIN_INTERVAL_MS=100
EDHREC_MIN_INTERVAL_MS=1000

# Intervalo mínimo entre peticiones a Archidekt / Moxfield (ms)
DECK_SOURCES_MIN_INTERVAL_MS=1000

# TTL de la caché de EDHREC en horas
EDHREC_CACHE_TTL_HOURS=24
# Commander Spellbook (combos): sin API oficial; caché por lista de cartas
SPELLBOOK_MIN_INTERVAL_MS=1000
SPELLBOOK_CACHE_TTL_HOURS=24

# --- Usuarios ---
# Secreto para firmar las sesiones (obligatorio en producción). Genera uno con:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública de la app (la misma que ves en el navegador, sin barra final). En Docker la pone
# docker-compose.yml a partir de DECK_DOCTOR_HOST.
BETTER_AUTH_URL="http://localhost:3000"

# Login con Google (opcional). Credenciales OAuth de Google Cloud Console con la URI de redirección
#   <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email para "olvidé mi contraseña" (opcional). Si falta, la opción no aparece.
#   SMTP_URL="smtps://usuario:clave@smtp.ejemplo.com:465"
SMTP_URL=
MAIL_FROM="Doctor Deck <no-reply@ejemplo.com>"

# App móvil: notificaciones push con Firebase Cloud Messaging (clave de una cuenta de servicio, el
# JSON tal cual o en base64) y versión mínima de la app (las anteriores piden actualizar).
FCM_SERVICE_ACCOUNT=
MOBILE_MIN_VERSION=1.0.0
# Huellas SHA-256 de los certificados de la app (Play Console › Integridad de la app › Firma de
# apps; separadas por comas): /.well-known/assetlinks.json, para que los enlaces abran la app.
ANDROID_CERT_SHA256=

# Copia de seguridad externa (opcional): cada noche `db:backup` cifra la copia con
# BACKUP_PASSPHRASE y la sube a un almacenamiento compatible con S3 (Backblaze B2, Cloudflare R2…).
# Guarda la contraseña también fuera del VPS: sin ella, las copias no se pueden abrir.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_PASSPHRASE=

# Páginas legales (/privacy y /legal): titular de la web (nombre y NIF si aplica) y email de
# contacto para privacidad. Sin ellas, las páginas lo indican como pendiente.
LEGAL_OWNER=
LEGAL_EMAIL=

# --- Moderación ---
# Emails (separados por comas) de quien revisa las denuncias de comentarios en /admin/reports.
ADMIN_EMAILS=
