# Copia este fichero a .env y ajusta los valores. .env nunca se sube al repo.

# SQLite local (ruta relativa a la raíz del proyecto)
DATABASE_URL="file:./data/deck-doctor.db"

# Carpeta donde se descargan los bulk data de Scryfall
SCRYFALL_DATA_DIR="./data/scryfall"

# User-Agent identificable para Scryfall y EDHREC, p. ej. "DeckDoctor/0.1 (tu-email-o-url)"
HTTP_USER_AGENT="DeckDoctor/0.1"

# Milisegundos mínimos entre peticiones
SCRYFALL_MIN_INTERVAL_MS=100
EDHREC_MIN_INTERVAL_MS=1000

# Intervalo mínimo entre peticiones a Archidekt / Moxfield (ms)
DECK_SOURCES_MIN_INTERVAL_MS=1000

# TTL de la caché de EDHREC en horas
EDHREC_CACHE_TTL_HOURS=24

# Contraseña para entrar en la app (pantalla /login). Vacía = sin login (desarrollo local).
APP_PASSWORD=
