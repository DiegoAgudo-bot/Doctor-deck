// Esquema inicial (Fase 0). Se ampliará en las fases 1-3.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Una carta "lógica" de Scryfall (bulk oracle_cards). Todas las ediciones comparten oracleId.
model OracleCard {
  oracleId       String     @id
  name           String
  /// nameKey(name): minúsculas, sin tildes, `//` normalizado. Para buscar por nombre.
  nameKey        String
  /// Nombre de la primera cara en cartas `A // B`.
  frontFaceName  String?
  /// nameKey(frontFaceName)
  frontFaceKey   String?
  layout         String
  manaCost       String?
  cmc            Float
  typeLine       String
  oracleText     String?
  /// Array JSON de keywords, p. ej. ["Flying","Partner"].
  keywords       String     @default("[]")
  /// Letras WUBRG concatenadas, p. ej. "UB". Vacío = incolora.
  colorIdentity  String
  legalCommander Boolean
  isBasicLand    Boolean    @default(false)
  edhrecRank     Int?
  imageUrl       String?
  /// En la lista de "game changers" de los brackets (Scryfall `game_changer`).
  gameChanger    Boolean    @default(false)
  /// Precio (EUR) de la impresión más barata; lo mantiene `insertPrintings`. Para ordenar por precio.
  minPriceEur    Float?
  printings      Printing[]

  @@index([nameKey])
  @@index([frontFaceKey])
  @@index([minPriceEur])
}

/// Una impresión concreta (bulk default_cards).
model Printing {
  scryfallId      String     @id
  oracleId        String
  oracle          OracleCard @relation(fields: [oracleId], references: [oracleId], onDelete: Cascade)
  setCode         String
  collectorNumber String
  lang            String
  imageUrl        String?
  /// Precio de referencia en EUR (Cardmarket, vía Scryfall `prices.eur`); null si no hay.
  priceEur        Float?
  priceEurFoil    Float?
  /// Nombre de la edición y fecha de salida ("YYYY-MM-DD").
  setName         String?
  releasedAt      String?

  @@index([oracleId])
  @@index([setCode, collectorNumber])
}

/// Etiquetas de Scryfall Tagger (`otag:`) de cada carta (las de `OTAG_ROLES`). Sin clave ajena a
/// OracleCard: el catálogo se vacía y se vuelve a llenar en cada `scryfall:sync`.
model CardOtag {
  oracleId String
  tag      String

  @@id([oracleId, tag])
  @@index([tag])
}

/// Cuándo se sincronizó por última vez cada etiqueta de Tagger y cuántas cartas tenía.
model OtagSync {
  tag      String   @id
  syncedAt DateTime
  cards    Int
}

model CollectionEntry {
  id              Int      @id @default(autoincrement())
  /// Identificador público (API `/api/collection/cards/{publicId}`). El `id` numérico no sale de la BD.
  publicId        String   @unique @default(uuid())
  /// Dueño. null = datos de antes de que hubiera usuarios (ver scripts/claim-orphans.ts).
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  scryfallId      String?
  oracleId        String?
  name            String
  setCode         String?
  collectorNumber String?
  quantity        Int
  foil            Boolean  @default(false)
  /// Idioma de la copia (código de Scryfall: "en", "es", "ja"…); null si no se sabe.
  language        String?
  /// Estado de la copia ("near_mint", "lightly_played"… como ManaBox); null si no se sabe.
  condition       String?
  /// "matched" | "unmatched"
  status          String
  /// Cómo se emparejó: "scryfallId" | "setNumber" | "name"; null si no se emparejó.
  matchMethod     String?
  /// Línea del CSV original.
  line            Int
  /// Fila original del CSV en JSON, para depurar emparejados fallidos.
  raw             String
  importedAt      DateTime @default(now())

  @@index([oracleId])
  @@index([userId, oracleId])
}

model Deck {
  id             Int                @id @default(autoincrement())
  /// Identificador público (URL /decks/{publicId} y API). El `id` numérico no sale de la BD.
  publicId       String             @unique @default(uuid())
  /// Dueño. null = datos de antes de que hubiera usuarios (ver scripts/claim-orphans.ts).
  userId         String?
  user           User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  theme          String?
  /// Lo que pegó el usuario (lista o link), para volver a analizarlo.
  input          String             @default("")
  /// "text" | "archidekt" | "moxfield"
  source         String             @default("text")
  /// Nombres de los comandantes, para listar sin consultar el catálogo.
  commanderNames String             @default("")
  /// Array JSON de oracleIds descartados para entrar.
  excluded       String             @default("[]")
  /// "public" (perfil, Comunidad y avisos) | "unlisted" (solo con el enlace) | "private".
  visibility     String             @default("public")
  /// Bracket al que apunta el mazo (1–5); null = sin objetivo.
  targetBracket  Int?
  /// Datos para filtrar en Comunidad, calculados al guardar (y tras cada `scryfall:sync`):
  /// identidad de color del comandante ("WUBRG"; "" = incolora) y bracket estimado (2–4).
  /// null = sin calcular todavía.
  colorIdentity  String?
  bracket        Int?
  /// Lo que me falta para este mazo entra en mi lista de deseos.
  inWishlist     Boolean            @default(false)
  likes          DeckLike[]
  /// Si se puede comentar (públicos y ocultos; el dueño puede cerrarlos).
  commentsOpen   Boolean            @default(true)
  comments       DeckComment[]
  gamePlayers    GamePlayer[]
  roleOverrides  DeckRoleOverride[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  cards          DeckCard[]
  decisions      SwapDecision[]

  @@index([userId])
  @@index([visibility, createdAt])
}

model DeckCard {
  id          Int     @id @default(autoincrement())
  deckId      Int
  deck        Deck    @relation(fields: [deckId], references: [id], onDelete: Cascade)
  oracleId    String
  quantity    Int     @default(1)
  isCommander Boolean @default(false)
  locked      Boolean @default(false)
  /// Impresión elegida (Scryfall ID); null = la más barata.
  scryfallId  String?

  @@unique([deckId, oracleId])
  @@index([oracleId])
}

model SwapDecision {
  id          Int      @id @default(autoincrement())
  deckId      Int
  deck        Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  outOracleId String
  inOracleId  String
  /// "accepted" | "rejected"
  status      String
  createdAt   DateTime @default(now())

  @@unique([deckId, outOracleId, inOracleId])
}

/// Caché HTTP genérica (EDHREC, API de Scryfall). El TTL se aplica al leer.
model HttpCache {
  url       String   @id
  status    Int
  body      String
  fetchedAt DateTime
}

// ---------- Usuarios (tablas de Better Auth; nombres y campos los fija la librería) ----------

model User {
  id                String             @id
  name              String
  email             String             @unique
  emailVerified     Boolean            @default(false)
  image             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  /// Nombre público (perfil /u/{username}). Se genera la primera vez que hace falta.
  username          String?            @unique
  /// Si cualquiera puede ver su colección en su perfil.
  collectionPublic  Boolean            @default(false)
  /// Lista de deseos y "para cambiar" visibles en el perfil y en los cruces de otros.
  tradesPublic      Boolean            @default(false)
  /// Avisar si una carta que me falta baja este % respecto a su máximo de 30 días. null = no avisar.
  priceAlertPercent Int?               @default(15)
  prefs             UserPref[]
  sessions          Session[]
  accounts          Account[]
  collection        CollectionEntry[]
  decks             Deck[]
  following         Follow[]           @relation("follower")
  followers         Follow[]           @relation("followed")
  notifications     Notification[]     @relation("recipient")
  sentNotifications Notification[]     @relation("actor")
  deckLikes         DeckLike[]
  cardRoles         CardRoleOverride[]
  wishlist          WishlistItem[]
  tradeKeeps        TradeKeep[]
  proposalsSent     TradeProposal[]    @relation("proposalFrom")
  proposalsReceived TradeProposal[]    @relation("proposalTo")
  groupsOwned       PlayGroup[]
  groups            GroupMember[]
  gamesCreated      Game[]
  gamesPlayed       GamePlayer[]
  loansGiven        Loan[]             @relation("lender")
  loansReceived     Loan[]             @relation("borrower")
  comments          DeckComment[]
  blocking          Block[]            @relation("blocker")
  blockedBy         Block[]            @relation("blocked")
  reports           CommentReport[]

  @@map("user")
}

/// `followerId` sigue a `followedId`.
model Follow {
  followerId String
  follower   User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followedId String
  followed   User     @relation("followed", fields: [followedId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([followerId, followedId])
  @@index([followedId])
}

/// Aviso para `userId` de algo que ha hecho `actorId` (alguien a quien sigue).
model Notification {
  id        Int       @id @default(autoincrement())
  userId    String
  user      User      @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User      @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)
  /// "new_deck" | "big_card" | "price_drop"
  type      String
  /// new_deck: publicId y nombre del mazo. big_card: oracleId, nombre y precio de la carta.
  deckId    String?
  cardId    String?
  title     String
  price     Float?
  /// price_drop: precio de referencia (máximo de los 30 días anteriores).
  prevPrice Float?
  /// trade_*: publicId de la propuesta de intercambio.
  tradeId   String?
  /// group_join: publicId del grupo. game: de la partida. loan: del préstamo.
  refId     String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
  @@index([userId, type, cardId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// Una forma de entrar: "credential" (email + contraseña, con `password` hasheada) o "google".
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// Tokens temporales (restablecer contraseña, estado de OAuth…).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Precio de cada día (el de la impresión más barata) de las cartas que alguien tiene en su
/// colección o en un mazo. Lo rellena `scryfall:sync` (cada noche) para el histórico de precios.
model PriceSnapshot {
  oracleId String
  /// Día en UTC, "YYYY-MM-DD".
  date     String
  eur      Float

  @@id([oracleId, date])
  @@index([date])
}

/// "Me gusta" de un usuario a un mazo (público u oculto) de otro.
model DeckLike {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deckId    Int
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, deckId])
  @@index([deckId])
}

/// Roles y etiquetas que un usuario ha corregido a mano para una carta (valen en todos sus mazos).
model CardRoleOverride {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  oracleId  String
  /// Array JSON de roles (vacío = usar los automáticos, solo etiquetas).
  roles     String   @default("[]")
  primary   String?
  /// Array JSON de etiquetas libres ("wincon", "tesoros"…).
  tags      String   @default("[]")
  updatedAt DateTime @updatedAt

  @@id([userId, oracleId])
}

/// Correcciones de roles de una carta que valen solo en un mazo (del dueño del mazo).
model DeckRoleOverride {
  deckId    Int
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  oracleId  String
  /// Array JSON de roles (vacío = no cambia los roles, solo etiquetas).
  roles     String   @default("[]")
  primary   String?
  /// Array JSON de etiquetas libres.
  tags      String   @default("[]")
  updatedAt DateTime @updatedAt

  @@id([deckId, oracleId])
}

/// Cartas que he añadido a mano a mi lista de deseos.
model WishlistItem {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  oracleId  String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@id([userId, oracleId])
}

/// Cartas que no cambio aunque tenga copias libres (salen de mi lista "para cambiar").
model TradeKeep {
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  oracleId String

  @@id([userId, oracleId])
}

/// Propuesta de intercambio entre dos usuarios (fase 19). Cada contrapropuesta es una versión
/// nueva; las líneas de las versiones anteriores se conservan como historial.
model TradeProposal {
  id         Int                 @id @default(autoincrement())
  /// Identificador público (URL /intercambios/propuestas/{publicId} y API).
  publicId   String              @unique @default(uuid())
  /// Quien la creó.
  fromUserId String
  fromUser   User                @relation("proposalFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User                @relation("proposalTo", fields: [toUserId], references: [id], onDelete: Cascade)
  /// "draft" | "pending" | "accepted" | "rejected" | "cancelled"
  status     String              @default("draft")
  /// pending: a quién le toca aceptar, rechazar o contraproponer.
  turnUserId String?
  /// Versión actual (1 = la propuesta original; cada contrapropuesta suma 1).
  version    Int                 @default(1)
  /// Quién hizo la versión actual.
  lastById   String
  /// Cuándo se aceptó, rechazó o canceló.
  closedAt   DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  items      TradeProposalItem[]

  @@index([fromUserId])
  @@index([toUserId])
}

/// Una línea de una versión de una propuesta: copias iguales que da `giverId`, con su precio
/// por copia en el momento de proponerla.
model TradeProposalItem {
  id         Int           @id @default(autoincrement())
  proposalId Int
  proposal   TradeProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  version    Int
  giverId    String
  oracleId   String
  scryfallId String?
  foil       Boolean       @default(false)
  language   String?
  quantity   Int
  unitPrice  Float?

  @@index([proposalId, version])
}

/// Precio de cada día de las impresiones que alguien tiene en su colección (normal y foil), para
/// el valor exacto de la colección. El de por carta (`PriceSnapshot`) sigue siendo el más barato.
model PrintingPriceSnapshot {
  scryfallId String
  /// Día en UTC, "YYYY-MM-DD".
  date       String
  eur        Float?
  eurFoil    Float?

  @@id([scryfallId, date])
  @@index([date])
}

// ---------- Fase 21: social ----------

/// Grupo de juego (los amigos con los que juegas). Se entra con el enlace de invitación.
model PlayGroup {
  id          Int           @id @default(autoincrement())
  /// Identificador público (URL /groups/{publicId}).
  publicId    String        @unique @default(uuid())
  name        String
  description String        @default("")
  /// Código del enlace de invitación (/groups/join/{inviteCode}); el dueño lo puede cambiar.
  inviteCode  String        @unique
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  members     GroupMember[]
  games       Game[]
}

model GroupMember {
  groupId  Int
  group    PlayGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime  @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

/// Una partida jugada (de un grupo o suelta), con quién jugó, con qué mazo y quién ganó.
model Game {
  id          Int          @id @default(autoincrement())
  publicId    String       @unique @default(uuid())
  groupId     Int?
  group       PlayGroup?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  playedAt    DateTime
  /// Turnos que duró (opcional).
  turns       Int?
  notes       String       @default("")
  createdAt   DateTime     @default(now())
  players     GamePlayer[]

  @@index([groupId, playedAt])
  @@index([createdById])
}

/// Un jugador de una partida: usuario de Doctor Deck o invitado (solo nombre).
model GamePlayer {
  id             Int     @id @default(autoincrement())
  gameId         Int
  game           Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  seat           Int
  userId         String?
  user           User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestName      String?
  /// Mazo guardado con el que jugó (si lo borra, queda el nombre).
  deckId         Int?
  deck           Deck?   @relation(fields: [deckId], references: [id], onDelete: SetNull)
  /// Nombre del mazo y comandantes en el momento de la partida.
  deckName       String  @default("")
  commanderNames String  @default("")
  winner         Boolean @default(false)

  @@index([gameId])
  @@index([userId])
  @@index([deckId])
}

/// Copias de una carta que presto: siguen siendo mías pero cuentan como ocupadas.
model Loan {
  id           Int       @id @default(autoincrement())
  publicId     String    @unique @default(uuid())
  lenderId     String
  lender       User      @relation("lender", fields: [lenderId], references: [id], onDelete: Cascade)
  /// A quién: un usuario de Doctor Deck o, si no tiene cuenta, solo su nombre.
  borrowerId   String?
  borrower     User?     @relation("borrower", fields: [borrowerId], references: [id], onDelete: SetNull)
  borrowerName String?
  oracleId     String
  name         String
  quantity     Int
  note         String    @default("")
  createdAt    DateTime  @default(now())
  returnedAt   DateTime?

  @@index([lenderId, returnedAt])
  @@index([borrowerId, returnedAt])
}

/// Comentario en un mazo público u oculto.
model DeckComment {
  id        Int             @id @default(autoincrement())
  publicId  String          @unique @default(uuid())
  deckId    Int
  deck      Deck            @relation(fields: [deckId], references: [id], onDelete: Cascade)
  authorId  String
  author    User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime        @default(now())
  /// Oculto por denuncias (hasta que lo revise un administrador) o por un administrador.
  hiddenAt  DateTime?
  reports   CommentReport[]

  @@index([deckId, createdAt])
  @@index([authorId, createdAt])
}

/// `blockerId` ha bloqueado a `blockedId`: no le sigue, no comenta sus mazos ni le propone nada.
model Block {
  blockerId String
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

/// Denuncia de un comentario (una por persona y comentario).
model CommentReport {
  commentId  Int
  comment    DeckComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User        @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  /// "spam" | "abuse" | "other"
  reason     String
  createdAt  DateTime    @default(now())
  /// Cuándo lo revisó un administrador (null = pendiente).
  reviewedAt DateTime?

  @@id([commentId, reporterId])
}

/// Preferencias de la interfaz (filtros, orden y vista de cada página), para que sigan en cualquier
/// navegador y en la app. `value` = JSON pequeño validado al guardar.
model UserPref {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@id([userId, key])
}

/// Errores de la app (del servidor y del navegador), agrupados por huella: se ven en /admin/errors.
model ErrorLog {
  id          Int      @id @default(autoincrement())
  /// source + mensaje normalizado + ruta: el mismo error repetido suma `count`.
  fingerprint String   @unique
  /// "server" | "client"
  source      String
  message     String
  stack       String?
  path        String?
  userAgent   String?
  count       Int      @default(1)
  firstAt     DateTime @default(now())
  lastAt      DateTime @default(now())

  @@index([lastAt])
}
